{
  "manifest_version": 3,
  "name": "Aura Camera — виртуальный фон",
  "version": "0.4.2",
  "description": "Локальная замена фона камеры на сайтах. Отдельный переключатель Meet; Selfie, RVM, MODNet и экспериментальная глубина.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aura Camera",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "preview.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "core.js",
        "native-refiner.js",
        "build-info.js",
        "models.js",
        "engine.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*.wasm",
        "vendor/*.mjs",
        "models/*.tflite",
        "models/*.onnx",
        "backgrounds/*.jpg",
        "native/*.wasm"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
